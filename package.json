{
  "name": "git-workbench",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roolefight/git4codex.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:codex": "tsc --noEmit && node scripts/build.mjs --codex",
    "package:codex": "node scripts/package-codex.mjs",
    "start": "node dist/cli.cjs",
    "test": "tsx --test tests/core.test.ts tests/http.test.ts tests/codex.test.ts tests/workspace.test.ts tests/worktrees.test.ts tests/resource.test.ts tests/thread-workspace.test.ts tests/safety.test.ts tests/syntax.test.ts",
    "test:dsh": "tsx --test tests/adapters.test.ts",
    "package": "node scripts/package-codex.mjs",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/mcp-extensions": "^0.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "lowlight": "3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "$zod"
    }
  }
}
